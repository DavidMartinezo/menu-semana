# Solo en producción: URL del backend desplegado (ej. https://menu-semana-api.onrender.com).
# Se usa al hacer `npm run build`. En desarrollo local déjala vacía (Vite usa su proxy).
VITE_API_URL=

# Opcional: clave del proyecto de PostHog (analítica). Sin esto, la app no manda nada
# a ningún lado. Consíguela gratis en https://posthog.com (Project Settings > API Keys).
VITE_POSTHOG_KEY=
# Host de tu proyecto — depende de la región que elegiste al crear el proyecto en PostHog.
VITE_POSTHOG_HOST=https://us.i.posthog.com
