# Tu API key de Groq (obligatoria, gratis). Consíguela en https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxx

# Modelo a usar. openai/gpt-oss-20b es gratis, rápido y da buena calidad para extraer recetas.
# Si quieres más precisión (a costa de velocidad), sube a openai/gpt-oss-120b.
MODEL=openai/gpt-oss-20b

# Opcional: API key de YouTube Data API v3 (para leer la descripción del video por la vía oficial).
# Sin esto, la app intenta solo la transcripción. Consíguela en https://console.cloud.google.com
YOUTUBE_API_KEY=

# Puerto del backend
PORT=3001

# Solo en producción: URL exacta del frontend desplegado (ej. https://menu-semana.onrender.com).
# Restringe qué sitios pueden llamar a esta API. En desarrollo déjala vacía.
CLIENT_URL=
